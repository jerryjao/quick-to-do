{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quick To Do",
  "version": "0.1.0",
  "identifier": "com.jerryjao.quick-to-do",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quick To Do",
        "width": 220,
        "height": 36,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
